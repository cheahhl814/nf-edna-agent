/.crew/
/.crew
!.crew/artifacts/
!.crew/graphs/
!.crew/artifacts/.gitkeep
!.crew/graphs/.gitkeep

# Large reference databases — keep these untracked, scientists supply their own
# (assets/ is at the skill root post-flatten; previously nested under nf-edna/)
assets/**/*.rdata
assets/**/*.rds
assets/**/*.fasta
assets/**/*.xlsx
assets/**/*.list

# Per-run outputs — must not be committed
results/

# Nextflow working directories + logs
work/
.nextflow.log*
.nextflow/
.cache/

# Compressed sequencing reads (intermediates)
/*.fq.gz
/*.fastq.gz
*.fq.gz
*.fastq.gz

# Pixi env cache (resolved on first run, regenerated per machine)
/.pixi/
__pycache__/

# Internal-only — not for the public GitHub repo
/docs/superpowers/
/tests/
__pycache__/
**/pixi.lock

# Meta-skill run artifacts — per-run regenerable, never commit (skill-battle-test check #6)
skill-built.md
battle-test-report.md
battle-test_evidence.txt
preflight.md
preflight_evidence.txt
tool_search_results.txt
tool-inventory.json
exec-canary-report.md
exec-canary_evidence.txt
handoff.md
handoff-archive.md
