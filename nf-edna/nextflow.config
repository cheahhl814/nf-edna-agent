manifest {
    name            = 'nf-edna'
    author          = 'Cheah Hong Leong'
    description     = 'eDNA metabarcoding pipeline (16S / 18S-V9 / COI / 12S via -params-file presets)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

params {
    // Run identity
    run_id          = "edna-${new java.util.Date().format('yyyyMMdd-HHmmss')}"
    results_dir     = "${launchDir}/results"

    // Inputs
    input_manifest  = ""
    metadata        = ""
    idtaxa_model    = ""

    // Marker identity and amplicon geometry — must be supplied via -params-file preset
    marker          = ""
    primers_fwd     = ""
    primers_rev     = ""
    min_length      = 0
    max_length      = 0
    kingdoms        = ""

    // Classification
    // 60% is the conservative default recommended by the IDTAXA paper (Murali et al. 2018,
    // Microbiome). Lower (e.g. 40%) increases taxonomic depth at the cost of more misassignments.
    idtaxa_threshold    = 60

    // Decontam
    decontam_threshold  = 0.1
    neg_col             = "is_negative"
    filter_condition    = "is_negative == false"

    // Diversity
    grouping_variable           = ""
    distance_metric             = "bray"
    clustering_method           = "ward.D2"
    num_clusters                = ""
    metadata_numeric_variables  = ""

    // Association
    reference_level     = ""
    daa_level           = "Genus"
    correlation_level   = "Genus"
    top_n_taxa_plot     = 20
    target_ranks        = "Phylum,Family,Genus"

    // Geocuration (optional post-classification geographic filtering)
    // Enable for fish/metazoa markers (12S, COI); leave false for 16S / 18S V9 protists
    geocurate        = false
    geocurate_coords = ""    // Required when geocurate=true: "latitude,longitude" e.g. "3.14,101.45"
    geocurate_buffer = 500   // Buffer radius in km around study site
}

process {
    cpus   = { check_max(1 * task.attempt, 'cpus') }
    memory = { check_max(6.GB * task.attempt, 'memory') }
    time   = { check_max(4.h * task.attempt, 'time') }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { check_max(4 * task.attempt, 'cpus') }
        memory = { check_max(12.GB * task.attempt, 'memory') }
        time   = { check_max(4.h * task.attempt, 'time') }
    }
    withLabel: process_medium {
        cpus   = { check_max(8 * task.attempt, 'cpus') }
        memory = { check_max(36.GB * task.attempt, 'memory') }
        time   = { check_max(8.h * task.attempt, 'time') }
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try { if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1) return params.max_memory as nextflow.util.MemoryUnit
              else return obj } catch (all) { return obj }
    } else if (type == 'time') {
        try { if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1) return params.max_time as nextflow.util.Duration
              else return obj } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) } catch (all) { return obj }
    }
}

params.max_memory = '220.GB'
params.max_cpus   = 48
params.max_time   = '240.h'
